   "source": [
    "#1. Find the largest, smallest, and second largest number from 10 user inputs.\n",
    "\n",
    "nums=[]\n",
    "for i in range(10):\n",
    "    n=int(input(\"Enter a integer: \"))\n",
    "    nums.append(n)\n",
    "print(nums)\n",
    "print(\"Largest number: \",max(nums))\n",
    "print(\"Smallest number: \",min(nums))\n",
    "\n",
    "\n",
    "\n",
    "\n"
   ]
  }
